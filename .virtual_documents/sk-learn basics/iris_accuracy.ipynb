import pandas as pd
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import accuracy_score

# Load the main dataset tab into a DataFrame
data = pd.read_excel('iris_dataset.xlsx', sheet_name='Iris Dataset')

# Display the first few rows to verify the headings
print(data.head())

X = data.iloc[:, :-1]  # All columns except the last as features
Y = data.iloc[:, -1]   # Last column as label


# Train the model
model = RandomForestClassifier()
model.fit(X, Y)


predictions = model.predict([[5.1,3.5,1.4,0.2]])


predictions


# Load your aligned test dataset
df1 = pd.read_excel("iris_test_aligned.xlsx")
testing = df1.iloc[:, :-1]


# Make predictions
predictions = model.predict(testing)
predictions


# Get actual labels from the test dataset (Fixed: using df1 instead of data)
y_test = df1.iloc[:, -1] 
actual = y_test.values
actual


# Calculate and print accuracy in percentage form
accuracy = accuracy_score(actual, predictions) * 100
print(f"Model Accuracy: {accuracy:.2f}%")






